import tkinter as tk
from tkinter import messagebox

# ==========================================
# ENIGMA MACHINE - MAIN APPLICATION
# ==========================================

class EnigmaMachine:

    def __init__(self, root):

        self.root = root

        self.root.title("Enigma Machine")
        self.root.geometry("800x480")
        self.root.configure(bg="#18243A")

        # Full screen
        self.root.attributes("-fullscreen", True)

        # Keyboard shortcuts
        self.root.bind("<Escape>", self.exit_fullscreen)
        self.root.bind("<F11>", self.toggle_fullscreen)

        # Plugboard data
        self.plugboard_pairs = {}
        self.selected_letter = None

        # Show home page
        self.show_home()


    # ======================================
    # GENERAL PAGE FUNCTIONS
    # ======================================

    def clear_page(self):

        for widget in self.root.winfo_children():
            widget.destroy()


    def create_header(self, title):

        header = tk.Frame(
            self.root,
            bg="#18243A",
            height=60
        )

        header.pack(fill="x", padx=20, pady=10)
        header.pack_propagate(False)

        back_button = tk.Button(
            header,
            text="← BACK",
            font=("Arial", 13, "bold"),
            bg="#344761",
            fg="white",
            activebackground="#506987",
            activeforeground="white",
            relief="flat",
            command=self.show_home
        )

        back_button.pack(side="left", padx=5)

        title_label = tk.Label(
            header,
            text=title,
            font=("Arial", 22, "bold"),
            fg="white",
            bg="#18243A"
        )

        title_label.pack(side="left", padx=25)

        return header


    def exit_fullscreen(self, event=None):

        self.root.attributes("-fullscreen", False)


    def toggle_fullscreen(self, event=None):

        current = self.root.attributes("-fullscreen")

        self.root.attributes("-fullscreen", not current)


    # ======================================
    # HOME PAGE
    # ======================================

    def show_home(self):

        self.clear_page()

        title = tk.Label(
            self.root,
            text="ENIGMA MACHINE",
            font=("Arial", 34, "bold"),
            fg="white",
            bg="#18243A"
        )

        title.pack(pady=45)

        subtitle = tk.Label(
            self.root,
            text="SELECT A FUNCTION",
            font=("Arial", 14),
            fg="#AAB8CC",
            bg="#18243A"
        )

        subtitle.pack(pady=5)

        button_frame = tk.Frame(
            self.root,
            bg="#18243A"
        )

        button_frame.pack(
            expand=True,
            fill="both",
            padx=35,
            pady=35
        )

        # Encryption button

        encryption_button = tk.Button(
            button_frame,
            text="ENCRYPTION /\nDECRYPTION",
            font=("Arial", 21, "bold"),
            fg="white",
            bg="#344F75",
            activebackground="#496A96",
            activeforeground="white",
            relief="flat",
            command=self.show_encryption
        )

        encryption_button.pack(
            side="left",
            expand=True,
            fill="both",
            padx=15
        )

        # Plugboard button

        plugboard_button = tk.Button(
            button_frame,
            text="PLUGBOARD",
            font=("Arial", 21, "bold"),
            fg="white",
            bg="#344F75",
            activebackground="#496A96",
            activeforeground="white",
            relief="flat",
            command=self.show_plugboard
        )

        plugboard_button.pack(
            side="left",
            expand=True,
            fill="both",
            padx=15
        )


    # ======================================
    # ENCRYPTION / DECRYPTION
    # ======================================

    def shift_text(self, text, shift):

        result = ""

        for letter in text:

            if "a" <= letter <= "z":

                new_letter = chr(
                    (ord(letter) - ord("a") + shift) % 26
                    + ord("a")
                )

                result += new_letter

            elif "A" <= letter <= "Z":

                new_letter = chr(
                    (ord(letter) - ord("A") + shift) % 26
                    + ord("A")
                )

                result += new_letter

            else:

                # Preserve spaces, numbers and punctuation
                result += letter

        return result


    def show_encryption(self):

        self.clear_page()

        self.create_header(
            "ENCRYPTION / DECRYPTION"
        )

        # INPUT SECTION

        input_frame = tk.LabelFrame(
            self.root,
            text=" INPUT TEXT ",
            font=("Arial", 13, "bold"),
            fg="white",
            bg="#18243A",
            labelanchor="nw"
        )

        input_frame.pack(
            fill="both",
            expand=True,
            padx=25,
            pady=5
        )

        self.input_text = tk.Text(
            input_frame,
            font=("Arial", 17),
            wrap="word",
            bg="#263750",
            fg="white",
            insertbackground="white",
            relief="flat",
            height=4
        )

        self.input_text.pack(
            fill="both",
            expand=True,
            padx=8,
            pady=8
        )

        # CONTROL BUTTONS

        control_frame = tk.Frame(
            self.root,
            bg="#18243A"
        )

        control_frame.pack(pady=10)

        encrypt_button = tk.Button(
            control_frame,
            text="ENCRYPT",
            font=("Arial", 13, "bold"),
            bg="#397D65",
            fg="white",
            activebackground="#4C9A7C",
            relief="flat",
            width=12,
            command=self.encrypt
        )

        encrypt_button.pack(side="left", padx=10)

        decrypt_button = tk.Button(
            control_frame,
            text="DECRYPT",
            font=("Arial", 13, "bold"),
            bg="#397D65",
            fg="white",
            activebackground="#4C9A7C",
            relief="flat",
            width=12,
            command=self.decrypt
        )

        decrypt_button.pack(side="left", padx=10)

        clear_button = tk.Button(
            control_frame,
            text="CLEAR",
            font=("Arial", 13, "bold"),
            bg="#A34B4B",
            fg="white",
            activebackground="#C26060",
            relief="flat",
            width=10,
            command=self.clear_text
        )

        clear_button.pack(side="left", padx=10)

        # OUTPUT SECTION

        output_frame = tk.LabelFrame(
            self.root,
            text=" OUTPUT TEXT ",
            font=("Arial", 13, "bold"),
            fg="white",
            bg="#18243A",
            labelanchor="nw"
        )

        output_frame.pack(
            fill="both",
            expand=True,
            padx=25,
            pady=5
        )

        self.output_text = tk.Text(
            output_frame,
            font=("Arial", 17),
            wrap="word",
            bg="#263750",
            fg="#83D6AE",
            relief="flat",
            height=4,
            state="disabled"
        )

        self.output_text.pack(
            fill="both",
            expand=True,
            padx=8,
            pady=8
        )


    def display_output(self, result):

        self.output_text.config(state="normal")

        self.output_text.delete("1.0", "end")

        self.output_text.insert("1.0", result)

        self.output_text.config(state="disabled")


    def encrypt(self):

        text = self.input_text.get(
            "1.0", "end-1c"
        )

        result = self.shift_text(text, 1)

        self.display_output(result)


    def decrypt(self):

        text = self.input_text.get(
            "1.0", "end-1c"
        )

        result = self.shift_text(text, -1)

        self.display_output(result)


    def clear_text(self):

        self.input_text.delete("1.0", "end")

        self.display_output("")


    # ======================================
    # PLUGBOARD
    # ======================================

    def show_plugboard(self):

        self.clear_page()

        self.create_header("PLUGBOARD")

        instruction = tk.Label(
            self.root,
            text="SELECT TWO DIFFERENT LETTERS TO CONNECT THEM",
            font=("Arial", 12),
            fg="#AAB8CC",
            bg="#18243A"
        )

        instruction.pack(pady=5)

        self.status_label = tk.Label(
            self.root,
            text="Select your first letter",
            font=("Arial", 13, "bold"),
            fg="#E8B85B",
            bg="#18243A"
        )

        self.status_label.pack(pady=5)

        # Canvas for letters and connection lines

        self.plug_canvas = tk.Canvas(
            self.root,
            bg="#18243A",
            highlightthickness=0
        )

        self.plug_canvas.pack(
            fill="both",
            expand=True,
            padx=15,
            pady=5
        )

        self.plug_canvas.bind(
            "<Configure>",
            self.draw_plugboard
        )

        # Clear all connections button

        clear_button = tk.Button(
            self.root,
            text="CLEAR ALL CONNECTIONS",
            font=("Arial", 11, "bold"),
            bg="#A34B4B",
            fg="white",
            relief="flat",
            command=self.clear_plugboard
        )

        clear_button.pack(pady=8)


    def draw_plugboard(self, event=None):

        canvas = self.plug_canvas

        canvas.delete("all")

        width = canvas.winfo_width()
        height = canvas.winfo_height()

        if width < 100 or height < 100:
            return

        letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

        # Three rows: 10, 9, 7 letters

        rows = [
            letters[0:10],
            letters[10:19],
            letters[19:26]
        ]

        # Calculate responsive spacing

        step = min((width - 80) / 9, 75)

        radius = min(25, step * 0.38)

        row_positions = [
            height * 0.20,
            height * 0.50,
            height * 0.80
        ]

        positions = {}

        for row_index, row in enumerate(rows):

            row_width = (len(row) - 1) * step

            start_x = (width - row_width) / 2

            y = row_positions[row_index]

            for i, letter in enumerate(row):

                x = start_x + i * step

                positions[letter] = (x, y)

        # Draw connection lines FIRST
        # Buttons and letters will be drawn on top.

        drawn_pairs = set()

        for letter, partner in self.plugboard_pairs.items():

            pair = frozenset((letter, partner))

            if pair in drawn_pairs:
                continue

            drawn_pairs.add(pair)

            x1, y1 = positions[letter]
            x2, y2 = positions[partner]

            canvas.create_line(
                x1, y1,
                x2, y2,
                fill="#E8B85B",
                width=4
            )

        # Draw letter buttons on top of lines

        for letter, (x, y) in positions.items():

            is_selected = (
                letter == self.selected_letter
            )

            is_connected = (
                letter in self.plugboard_pairs
            )

            if is_selected:
                fill = "#F1C75B"

            elif is_connected:
                fill = "#397D65"

            else:
                fill = "#E6EAF0"

            text_colour = "#18243A"

            canvas.create_oval(
                x - radius,
                y - radius,
                x + radius,
                y + radius,
                fill=fill,
                outline="#FFFFFF",
                width=2,
                tags=("letter", "letter_" + letter)
            )

            canvas.create_text(
                x,
                y,
                text=letter,
                font=("Arial", 15, "bold"),
                fill=text_colour,
                tags=("letter", "letter_" + letter)
            )

            canvas.tag_bind(
                "letter_" + letter,
                "<Button-1>",
                lambda event, l=letter:
                    self.select_plug_letter(l)
            )


    def select_plug_letter(self, letter):

        # First selection

        if self.selected_letter is None:

            if letter in self.plugboard_pairs:

                self.status_label.config(
                    text=letter + " is already connected. Clear connections to reset."
                )

                return

            self.selected_letter = letter

            self.status_label.config(
                text="Selected " + letter + ". Now select another letter."
            )

            self.draw_plugboard()

            return

        # Clicking the same letter cancels selection

        if letter == self.selected_letter:

            self.selected_letter = None

            self.status_label.config(
                text="Selection cancelled. Choose a letter."
            )

            self.draw_plugboard()

            return

        first_letter = self.selected_letter

        # Do not allow a letter to have multiple connections

        if letter in self.plugboard_pairs:

            self.status_label.config(
                text=letter + " is already connected. Choose another letter."
            )

            return

        # Create the connection

        self.plugboard_pairs[first_letter] = letter

        self.plugboard_pairs[letter] = first_letter

        self.selected_letter = None

        self.status_label.config(
            text=first_letter + " <-> " + letter + " connected!"
        )

        self.draw_plugboard()


    def clear_plugboard(self):

        self.plugboard_pairs.clear()

        self.selected_letter = None

        self.status_label.config(
            text="All connections cleared. Select a letter."
        )

        self.draw_plugboard()


# ==========================================
# START APPLICATION
# ==========================================

if __name__ == "__main__":

    root = tk.Tk()

    app = EnigmaMachine(root)

    root.mainloop()
